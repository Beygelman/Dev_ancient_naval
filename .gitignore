# Godot imports, C# outputs and local editor state
.godot/
**/bin/
**/obj/
.vs/
.idea/
*.user
*.suo
*.userprefs

# Generated Android project, local signing credentials, exports
/android/
/builds/
/exports/
*.keystore
*.jks
export_credentials.cfg

# Full local launch copies; Git carries the corresponding Windows ZIP.
# The raw Godot executable exceeds GitHub's regular-file size limit.
/releases/*/playable/

# Local validation / environment files
.local/
NuGet.local.config
NuGet.Config
