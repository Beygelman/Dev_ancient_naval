<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>DevAncientNaval</RootNamespace>
    <AssemblyName>Dev_ancient_naval</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GodotTargetPlatform)' == 'ios'">
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <DefineConstants>$(DefineConstants);ANCIENT_NAVAL_IOS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(GodotTargetPlatform)' == 'ios'">
    <Compile Remove="tests/Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="src/Core/**/*.cs;tests/CoreChecks/**/*.cs;docs/**/*.cs;releases/**/*.cs" />
    <ProjectReference Include="src/Core/DevAncientNaval.Core.csproj" />
  </ItemGroup>
</Project>
